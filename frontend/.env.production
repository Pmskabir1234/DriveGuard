VITE_API_BASE_URL=https://https://driveguard-ideatex.onrender.com
VITE_WS_BASE_URL=wss://driveguard-ideatex.onrender.com

# Note: Use wss:// (not ws://) for WebSocket in production because HTTPS
# sites require secure WebSocket. You'll fill in the actual Render URL after 
